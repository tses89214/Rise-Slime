{
  "name": "rise-slime",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "collector": "uv run --with-requirements collector/requirements.txt uvicorn collector.main:app --host 0.0.0.0 --port ${PORT:-3000}",
    "bots": "tsx src/bots/run.ts",
    "schema": "tsx tools/export-schema.ts",
    "test:collector": "uv run --with-requirements collector/requirements.txt python -m pytest collector -q"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  }
}
